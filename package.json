{
  "name": "tuai",
  "version": "0.1.0",
  "description": "Pull-based, Merkle-root reward claims for FoldingCash on Bitcoin Cash (CashScript)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "contracts": "tsx scripts/compile-contracts.ts",
    "gate": "bash scripts/gerbang-ujian.sh",
    "vectors": "tsx scripts/vectors.ts",
    "claim-sizes": "tsx scripts/claim-sizes.ts",
    "tuai": "tsx bin/tuai.ts",
    "push-measure": "tsx scripts/push-measure.ts",
    "cost": "tsx scripts/cost.ts",
    "demo:mock": "vitest run tests/cli-e2e.test.ts --reporter=verbose",
    "web:dev": "vite",
    "web:build": "vite build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "cashc": "0.14.0",
    "cashscript": "0.14.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
