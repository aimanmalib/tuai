# Route for the public host name to the tuai container, on its own router so a certificate problem here cannot
# affect any other name. deploy/deploy.sh fills the @...@ values from deploy/hos.env and copies the result into the
# proxy's dynamic configuration folder.
# HTML is sent with `Cache-Control: no-transform`, so a CDN in front does not compress it: the `compress` middleware
# does, with its 1024-byte floor lowered so the small index page is compressed too.
http:
  routers:
    tuai:
      entryPoints: [https]
      rule: Host(`@DOMAIN@`)
      service: tuai-svc
      middlewares: [tuai-compress]
      tls:
        certResolver: @CERT_RESOLVER@
      priority: 100
    tuai-http:
      entryPoints: [http]
      rule: Host(`@DOMAIN@`)
      service: tuai-svc
      middlewares: [tuai-https]
      priority: 100
  middlewares:
    tuai-compress:
      compress:
        minResponseBodyBytes: 256
    tuai-https:
      redirectScheme:
        scheme: https
        permanent: true
  services:
    tuai-svc:
      loadBalancer:
        servers:
          - url: http://tuai:8080
