# Copy to deploy/hos.env (not tracked) and fill in the values of the host that runs the container.
TUAI_DOMAIN=tuai.example.com
TUAI_NETWORK=proxy                 # existing Docker network shared with the reverse proxy
PROXY_CONTAINER=proxy              # reverse proxy container (Traefik v3, file provider)
PROXY_DYNAMIC_DIR=/traefik/dynamic # file provider folder inside that container
CERT_RESOLVER=letsencrypt
BUILD_CMD="docker build"           # anything that accepts `docker build` arguments
MIN_FREE_GB=8
BROWSER_CMD=                       # optional prefix for the browser check, e.g. a queue wrapper
TUAI_RELAY_KEY_FILE=               # optional: absolute path of the relayer's chipnet key file (tuai relay-key); empty = no relayer
TUAI_RELAY_OFF=0                   # 1 switches the relayer off at the next deploy/deploy.sh
